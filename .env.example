# Public URL of the production site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.example.com.br

# Search indexing stays OFF until the client approves content and credentials.
# Set to "true" only after CLIENT_APPROVAL_REQUIRED.md is resolved.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Contact form delivery (optional). If unset, the form will NOT pretend to send:
# it shows an honest "not yet connected" state and points to direct contact routes.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
